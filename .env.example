PORT=3000

# Tenant App API URL (used to authenticate employees and access shared data).
# Points to the Tenant App's base URL.
TENANT_APP_URL=http://localhost:3100

# Secret used to sign employee session cookies.
# Generate a long random value for production.
EMPLOYEE_SESSION_SECRET=dev-employee-session-secret-do-not-use-in-prod

# Shared API key for server-to-server calls to the Tenant App.
# Must match the ADMIN_API_KEY configured in the Tenant App.
# Required for employee login, claim submission, and receipt operations.
ADMIN_API_KEY=
